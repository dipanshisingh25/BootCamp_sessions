import csv

with open("contacts.csv", "w", newline="") as file:
    writer = csv.DictWriter(file, fieldnames=["Name", "Phone"])

    writer.writeheader()

    writer.writerows([
        {"Name": "Aman", "Phone": "9876543210"},
        {"Name": "Priya", "Phone": "9876543211"},
        {"Name": "Anjali", "Phone": "9876543212"},
        {"Name": "Rahul", "Phone": "9876543213"},
        {"Name": "Amit", "Phone": "9876543214"}
    ])


with open("contacts.csv", "r", newline="") as file:
    reader = csv.DictReader(file)

    
    for contact in reader:
        if contact["Name"].startswith("A"):
            print(contact)

